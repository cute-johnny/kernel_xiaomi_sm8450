# Power
CONFIG_BQ_FG_UPDATE=y
CONFIG_MI_CHARGER_M81=y
CONFIG_MI_THERMAL_MULTI_CHARGE=y
CONFIG_WIRELESS_REVERSE_CLOSE=y

# uh yes 
CONFIG_LOCALVERSION="-Weil+"

# KernelSU Next
CONFIG_KSU=y

# ZRAM Writeback (for Android 17 mmd)
CONFIG_ZRAM_WRITEBACK=y

# Enable cgroup PSI + kmem accounting for cgroup v2 memory management (overrides gki_defconfig)
CONFIG_CMDLINE="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected"

# ZRAM multi-compression / recompression (lz4 primary, zstd secondary via mmd)
CONFIG_ZRAM_MULTI_COMP=y

# Multi-Gen LRU (MGLRU) backport from android13-5.10 (enabled at boot; min_ttl_ms left at 0)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Kernel BTF (lets the bpfloader load timeInState etc. so batterystats gets per-app CPU power)
CONFIG_DEBUG_INFO_BTF=y

# TCP BBR congestion control, used by default (BBR needs TCP_CONG_ADVANCED;
# keep the other algorithms out so no new .ko modules appear)
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
